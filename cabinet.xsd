<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="http://www.univ-grenoble-alpes.fr/l3miage/medical"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns="http://www.univ-grenoble-alpes.fr/l3miage/medical"
    xmlns:ci="http://www.univ-grenoble-alpes.fr/l3miage/medical"
    elementFormDefault="qualified"
>


    <xs:element name="cabinet" type="Cabinet">


        <!--  unique idInfirmier -->
        <xs:key name="UniqueIdInfirmier">
            <xs:selector xpath="ci:infirmiers/ci:infirmier" />
            <xs:field xpath="@id" />
        </xs:key>


        <xs:keyref name="visiteIntervenant" refer="UniqueIdInfirmier">
            <xs:selector xpath="ci:patients/ci:patient/ci:visite" />
            <xs:field xpath="@intervenant"/>
        </xs:keyref>

    </xs:element>


    <!-- type Cabinet-->
    <xs:complexType name="Cabinet">
        <xs:sequence>
            <xs:element name="nom" />
            <xs:element name="adresse" type="Adresse" />
            <xs:element name="infirmiers" type="Infirmiers" />
            <xs:element name="patients" type="Patients" />
        </xs:sequence>
    </xs:complexType>

    <!-- type adresse-->
    <xs:complexType name="Adresse">
        <xs:sequence>
            <xs:element name="etage" type="xs:int" minOccurs="0" />
            <xs:element name="numero" type="xs:int" minOccurs="0" />
            <xs:element name="rue" />
            <xs:element name="codePostal" type="CodePostal" />
            <xs:element name="ville" />
        </xs:sequence>
    </xs:complexType>


    <!-- type Infirmiers -->
    <!-- on a 3 infirmieres, mais on peux s'agrandir-->
    <xs:complexType name="Infirmiers">
        <xs:sequence>
            <xs:element name="infirmier" type="Infirmier" minOccurs="3" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>


    <!-- type Infirmier-->
    <xs:complexType name="Infirmier">
        <xs:sequence>
            <xs:element name="nom" />
            <xs:element name="prenom" />
            <xs:element name="photo" type="xs:anyURI" />
        </xs:sequence>
        <xs:attribute name="id" type="IdInfirmier" use="required" />
    </xs:complexType>


    <!-- type Patients -->
    <!--we
    can have 0 Patients
     nd also we can have a lot of Patients
     -->
    <xs:complexType name="Patients">
        <xs:sequence>
            <xs:element name="patient" type="Patient" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>


    <!-- type Patients -->
    <xs:complexType name="Patient">
        <xs:sequence>
            <xs:element name="nom" />
            <xs:element name="prenom" />
            <xs:element name="sexe" type="Sexe" />
            <xs:element name="naissance" type="xs:date" />
            <xs:element name="numero" type="NumeroSecu" />
            <xs:element name="adresse" type="Adresse" />
            <xs:element name="visite" type="Visite" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>


    <!-- type Visite -->
    <xs:complexType name="Visite">
        <xs:sequence>
            <xs:element name="acte" type="Acte" maxOccurs="unbounded" />
        </xs:sequence>
        <xs:attribute name="date" type="xs:date" use="required" />
        <xs:attribute name="intervenant" type="IdInfirmier" />
    </xs:complexType>


    <!-- type Acte -->
    <xs:complexType name="Acte">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:int" use="required" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>


    <!-- id infirmier 3 chifres-->
    <xs:simpleType name="IdInfirmier">
        <xs:restriction base="xs:string">
            <xs:pattern value="\d{3}" />
        </xs:restriction>
    </xs:simpleType>

    <!-- the type Numero Securite sociale-->
    <xs:simpleType name="NumeroSecu">
        <xs:restriction base="xs:string">
            <xs:pattern value="\d{15}" />
        </xs:restriction>
    </xs:simpleType>


    <!-- le code postal (un nombre a 5 chiffres) -->

    <xs:simpleType name="CodePostal">
        <xs:restriction base="xs:string">
            <xs:pattern value="\d{5}" />
        </xs:restriction>
    </xs:simpleType>

    <!-- type sex must be just M or F -->
    <xs:simpleType name="Sexe">
        <xs:restriction base="xs:string">
            <xs:enumeration value="M" />
            <xs:enumeration value="F" />
        </xs:restriction>
    </xs:simpleType>


    <!-- type Photo -->
    <!-- <xs:simpleType name="Photo">
        <xs:restriction base="xs:string">
            <xs:pattern value=".+\.(png|jpg|jpeg)" />
        </xs:restriction>
    </xs:simpleType> -->


</xs:schema>