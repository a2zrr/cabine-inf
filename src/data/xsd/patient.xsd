<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="http://www.univ-grenoble-alpes.fr/l3miage/medical"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.univ-grenoble-alpes.fr/l3miage/medical"
           elementFormDefault="qualified"
    >

    <!-- type adresse-->
    <xs:complexType name="Adresse">
        <xs:sequence>
            <xs:element name="etage" type="xs:int" minOccurs="0" />
            <xs:element name="numero" type="xs:int" minOccurs="0" />
            <xs:element name="rue" />
            <xs:element name="codePostal" type="CodePostal" />
            <xs:element name="ville" />
        </xs:sequence>
    </xs:complexType>

    <!-- type Patients -->
    <!--we
         can have 0 Patients
         nd also we can have a lot of Patients
    -->
    <xs:complexType name="Patients">
        <xs:sequence>
            <xs:element name="patient" type="Patient" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>

    <!-- type Patients -->
    <xs:complexType name="Patient">
        <xs:sequence>
            <xs:element name="nom" />
            <xs:element name="prenom" />
            <xs:element name="sexe" type="Sexe" />
            <xs:element name="naissance" type="xs:date" />
            <xs:element name="numero" type="NumeroSecu" />
            <xs:element name="adresse" type="Adresse" />
            <xs:element name="visite" type="Visite" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>

    <!-- type Visite -->
    <xs:complexType name="Visite">
        <xs:sequence>
            <xs:element name="acte" type="Acte" maxOccurs="unbounded" />
        </xs:sequence>
        <xs:attribute name="date" type="xs:date" use="required" />
        <xs:attribute name="intervenant" type="IdInfirmier" />
    </xs:complexType>

    <!-- type Acte -->
    <xs:complexType name="Acte">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:int" use="required" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- id infirmier 3 chifres-->
    <xs:simpleType name="IdInfirmier">
        <xs:restriction base="xs:string">
            <xs:pattern value="\d{3}" />
        </xs:restriction>
    </xs:simpleType>

    <!-- the type Numero Securite sociale-->
    <xs:simpleType name="NumeroSecu">
        <xs:restriction base="xs:string">
            <xs:pattern value="[12][0-9]{14}" />
        </xs:restriction>
    </xs:simpleType>

    <!-- le code postal (un nombre a 5 chiffres) -->
    <xs:simpleType name="CodePostal">
        <xs:restriction base="xs:string">
            <xs:pattern value="\d{5}" />
        </xs:restriction>
    </xs:simpleType>

    <!-- type sex must be just M or F -->
    <xs:simpleType name="Sexe">
        <xs:restriction base="xs:string">
            <xs:enumeration value="M" />
            <xs:enumeration value="F" />
        </xs:restriction>
    </xs:simpleType>

</xs:schema>